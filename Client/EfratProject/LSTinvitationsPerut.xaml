<Page x:Class="EfratProject.LSTinvitationsPerut"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="LSTinvitationsPerut" Background="White">

    <StackPanel FlowDirection="RightToLeft">
        <Button HorizontalAlignment="Left" Background="Beige" Content="חזור" Click="quit" FontSize="20"/>


        <ScrollViewer VerticalScrollBarVisibility="Auto" >
            <StackPanel>
                <Button Content="עדכון מחיר וכמות המוצר" Click="DidntArrived" Name="arr" Visibility="Collapsed"   />
                <ListView x:Name="lstbuy" FlowDirection="RightToLeft" FontSize="15">
                    <ListView.View>
                        <GridView >
                            <!--<GridViewColumn Header="תמונה " DisplayMemberBinding="{Binding }" Width="65"/>-->
                            <GridViewColumn Header="תמונה" Width="85">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image Height="50">
                                            <Image.Source>
                                                <Binding Path="product.picture">
                                                    <Binding.Converter>
                                                        <local:ImageConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Image.Source>
                                        </Image>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="שם מוצר" DisplayMemberBinding="{Binding product.ProductName}" Width="85"/>
                            <GridViewColumn Header="כמות " DisplayMemberBinding="{Binding Amount}" Width="65"/>
                            <GridViewColumn Header="מחיר " x:Name="p" DisplayMemberBinding="{Binding price}" Width="65"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <WrapPanel FlowDirection="RightToLeft">
                    <TextBlock Text="סך הכל"></TextBlock>
                    <TextBlock Width="10"></TextBlock>
                    <TextBlock Name="Pay" />
                    <TextBlock Text="₪" />
                    <!--Text="{Binding sum}"-->
                </WrapPanel>
            </StackPanel>
        </ScrollViewer>
    </StackPanel>
</Page>
