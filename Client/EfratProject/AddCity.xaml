<Page x:Class="EfratProject.AddCity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddCity">
    <Page.Background>
        <ImageBrush  ImageSource="/pictures/backrround.jpg"  >
        </ImageBrush>
    </Page.Background>


    <Grid  FlowDirection="RightToLeft">
        <StackPanel  HorizontalAlignment="Stretch">
            <Image Source="/pictures/City.png" />
            <TextBlock Text="שם העיר" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=CityName}"/>-->
            <TextBox  Width="150" >
                <Binding Path="CityName">
                    <Binding.ValidationRules>
                        <local:ValidationHebrew/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
            <TextBlock Text="יום חלוקה (במספר 1-6)" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=DayInWeek}" />-->
            <TextBox  Width="150" >
                <Binding Path="DayInWeek">
                    <Binding.ValidationRules>
                        <local:ValidationNumDay/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>

            <Button  Background="Transparent" BorderThickness="0" Click="Save">
                <!--לחצן שמור-->
                <Image Height="53" Source="/pictures/Save.png" />
            </Button>
            <TextBlock Name="txtbed" Foreground="red" HorizontalAlignment="Center"/>
            <TextBlock Name="txtgood" Foreground="Green" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>
