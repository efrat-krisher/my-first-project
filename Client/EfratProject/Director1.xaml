<Page x:Class="EfratProject.Director1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Director1">
    <Page.Background>
        <ImageBrush  ImageSource="/pictures/home-cat-2_2.jpg" />
    </Page.Background>
    <Grid>
        <StackPanel >
            
            <WrapPanel FlowDirection="RightToLeft" >
                <Image Source="/pictures/LOGOEK.png" Height="84" Width="112" />
                <!--<Button Background="LightYellow" Content="איזור אישי" Click="Button_Click" Height="76" Width="77" FontWeight="Bold" FontSize="14"/>-->
                <Button x:Name="Home" Background="LightYellow" Click="goHome" Height="80" Width="80" ToolTip="חזרה לדף הבית">
                    <Image Source="/pictures/home.svg.png" Height="65" />
                    <!--בית-->
                </Button>
            </WrapPanel>
            <Button Background="LightYellow" Content="רשימת הזמנות" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_1" Height="60" Width="280" />
            <Button Background="LightYellow" Content="רשימת מוצרים" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_2" Height="60" Width="280" />
            <Button Background="LightYellow" Content="רשימת לקוחות" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_3" Height="60" Width="280" />
            <!--<Button Background="LightYellow" Content="רשימת קטגוריות" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_4" Height="60" Width="280" />-->
            <Button Background="LightYellow" Content="רשימת כשרויות" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_5" Height="60" Width="280" />
            <Button Background="LightYellow" Content="רשימת ערים" FontSize="30" FontWeight="ExtraBold" BorderBrush="Black" Click="Button_Click_6" Height="60" Width="280" />
        </StackPanel>
    </Grid>
</Page>
