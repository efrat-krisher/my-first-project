<Page x:Class="EfratProject.NewCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewCustomer">
 
  
    <StackPanel Background="White" FlowDirection="RightToLeft" HorizontalAlignment="Stretch">
            <!--<TextBlock   Text="רישום לקוח חדש" HorizontalAlignment="Center" FontSize="20" Background="CadetBlue"/>-->
            <Image Source="/pictures/Clientp.png" />
            <TextBlock Text="שם פרטי" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
            <!--<TextBox Width="150" Text="{Binding Path=FirstName}"/>-->
        <TextBox  Width="150" >
            <Binding Path="FirstName">
                <Binding.ValidationRules>
                    <local:ValidationHebrew/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="שם משפחה" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=LastName}"/>-->
        <TextBox  Width="150" >
            <Binding Path="LastName">
                <Binding.ValidationRules>
                    <local:ValidationHebrew/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="פלאפון נייד" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=phone}"/>-->
        <TextBox  Width="150"  >
            <Binding Path="phone">
                <Binding.ValidationRules>
                    <local:ValidationPhone/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock  Text="עיר" FontSize="15" HorizontalAlignment="Center"/>
            <ComboBox  Name="cmCity" SelectedItem="{Binding city1}" Width="150" DisplayMemberPath="CityName" >
                <!--<ComboBoxItem Content="אלעד"/>
                <ComboBoxItem Content="פתח תקווה"/>
                <ComboBoxItem Content="ראש העין"/>
                <ComboBoxItem Content="שוהם"/>-->
            </ComboBox>
        <TextBlock Text="רחוב" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150"  Text="{Binding Path=adress}"/>-->
        <TextBox  Width="150" >
            <Binding Path="adress">
                <Binding.ValidationRules>
                    <local:ValidationHebrew/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="מספר בית" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=hous}"/>-->
        <TextBox  Width="150"  >
            <Binding Path="hous">
                <Binding.ValidationRules>
                    <local:ValidationNum/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="קומה" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=floor}"/>-->
        <TextBox  Width="150"  >
            <Binding Path="floor">
                <Binding.ValidationRules>
                    <local:ValidationNum/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="מספר דירה" FontSize="15" HorizontalAlignment="Center"/>
            <!--<TextBox Width="150" Text="{Binding Path=apartment}"/>-->
        <TextBox  Width="150"  >
            <Binding Path="apartment">
                <Binding.ValidationRules>
                    <local:ValidationNum/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <TextBlock Text="מייל" FontSize="15" HorizontalAlignment="Center"/>
        <!--<TextBox Width="150" Text="{Binding Path=mail}"/>--> 
        <TextBox  Width="150"  >
            <Binding Path="mail">
                <Binding.ValidationRules>
                    <local:ValidationMail/>
                </Binding.ValidationRules>
            </Binding>
        </TextBox>
        <Button  Background="Transparent" BorderThickness="0" Click="Button_Click" >
                <!--לחצן שמור-->
                <Image Height="53" Source="/pictures/Save.png" />
            </Button>
            <TextBlock Name="txtbed" Foreground="red"/>       
            <TextBlock Name="txtgood" Foreground="Green"/>
        </StackPanel>
  
</Page>
