<Page x:Class="EfratProject.AddKategor"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddKategor">
    <Page.Background>
        <ImageBrush  ImageSource="/pictures/backrround.jpg"  >
        </ImageBrush>
    </Page.Background>
    <Grid FlowDirection="RightToLeft">
        <StackPanel  HorizontalAlignment="Stretch">
            <!--<TextBlock   Text="הוספת קטגוריה חדשה" HorizontalAlignment="Center" FontSize="20" Background="Beige"/>-->
            <Image Source="/pictures/AddKategor.png" />
            <TextBlock Text="שם קטגוריה" HorizontalAlignment="Center"/>
            <TextBox Width="150" Text="{Binding Path=KategorName}"/>
            <Button Background="Transparent" BorderThickness="0" Click="AddPicture">
                <!--לחצן הוספת תמונה-->
                <Image  Height="53" Source="/pictures/AddPicture.png"  />
            </Button>
            <Image Height="105" x:Name="image1"/>
            <Button  Background="Transparent" BorderThickness="0" Click="Save">
                <!--לחצן שמור-->
                <Image Height="53" Source="/pictures/Save.png" />
            </Button>
            <TextBlock Name="txtbed" Foreground="red"/>
            <TextBlock Name="txtgood" Foreground="Green"/>
        </StackPanel>
    </Grid>
</Page>
