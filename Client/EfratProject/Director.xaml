            <Image Source="/pictures/directEnter.png" />
            <!--<PasswordBox Width="150" Name="txt" Password="1234"/>--> 
            <PasswordBox Width="150" Name="txt" />
            <Button Background="Transparent" BorderThickness="0" Click="Button_Click_1" IsDefault="True" >
                <Image Height="53" Source="/pictures/OK.png" />
                <!--לחצן אישור-->
            </Button>
        </StackPanel>
