<UserControl  x:Class="EfratProject.UCproduct"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:EfratProject"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  
             Margin="20" Height="400" Width="255">
    <StackPanel   Background="White" Width="255" Height="400">
        <Image x:Name="Pimage" Stretch="Uniform" Height="208" Width="225" Margin="10" >
                                                <Image.Source>
                                        <Binding Path="picture">
                                            <Binding.Converter>
                                                <local:PicturConvert/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Image.Source>
        </Image>

        <TextBlock FontSize="20" Foreground="Black" Name="prname"  Text="{Binding ProductName }" /> <!--VerticalAlignment="Center"-->   <!--HorizontalAlignment="Center"-->
        <WrapPanel>
            <TextBlock   FontSize="20" Foreground="Black" Name="prprice"  HorizontalAlignment="Center" Text="{Binding BlProduct.price }"   VerticalAlignment="Center" /><!--Margin="80,0,0,0"--> 
            <TextBlock FontSize="20" Text="₪" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </WrapPanel>
        <TextBlock Name="prKosh" FontSize="20"  Text="{Binding Kosher.KosherName }" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <WrapPanel FlowDirection="RightToLeft" HorizontalAlignment="Center" >
            <Button Background="Transparent"  BorderThickness="0" Click="Plus" ToolTip="פלוס">
                <Image  Width="35" Source="/pictures/brankic1979 plus2.svg.png" /> <!--לחצן פלוס-->
            </Button>
            <TextBlock Width="60" Background="LightYellow"  Text=" 0" FontSize="35" x:Name="Amount1" HorizontalAlignment="Center"  />
            <Button  Background="Transparent"  BorderThickness="0" Click="Minus" ToolTip="מינוס"> <!--לחצן מינוס-->
                <Image Width="35" Source="/pictures/brankic1979 minus2.svg.png" />
            </Button>
            <TextBlock Height="40"  Text="קג'"/>

        </WrapPanel>
        <TextBlock x:Name="Finished" Text="אזל מהמלאי" Foreground="#FFC10035" Grid.Row="2" FontSize="20" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
        <Button x:Name="BtnAdd" Content="הוספה" BorderThickness="0" Background="LightYellow" Height="30" Click="Add" Margin="0,-10,0,0"/>
    </StackPanel>
</UserControl>
