<Page x:Class="EfratProject.lstCustomer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="lstCustomer">

    <StackPanel FlowDirection="RightToLeft" VerticalAlignment="Top">
        <DockPanel>
            <Button Content="חזור לתפריט" Width="116" FontSize="20"  Click="Back"  />
            <Button  x:Name="delete" Content="מחיקת לקוח"  Click="Delete" Width="150" Height="30" />
        </DockPanel>
        <TextBlock Text="רשימת לקוחות" Background="Beige" FontSize="14" />
        <ListView x:Name="lstCustomers" Width="auto" FontSize="15" >
            <ListView.View>
                <GridView >
                    <GridViewColumn Header="שם משפחה" DisplayMemberBinding="{Binding LastName}" Width="70"/>
                    <GridViewColumn Header="שם פרטי" DisplayMemberBinding="{Binding FirstName}" Width="70"/>
                    <GridViewColumn Header="עיר" DisplayMemberBinding="{Binding city1}" Width="70"/>  
                    <GridViewColumn Header="רחוב" DisplayMemberBinding="{Binding adress}" Width="70"/>
                    <GridViewColumn Header="מס' בית" DisplayMemberBinding="{Binding hous}" Width="70"/>
                    <GridViewColumn Header="מס' דירה" DisplayMemberBinding="{Binding apartment}" Width="70"/> 
                    <GridViewColumn Header="קומה" DisplayMemberBinding="{Binding floor}" Width="70"/>  
                    <GridViewColumn Header="טלפון" DisplayMemberBinding="{Binding phone}" Width="85"/>  
                    <GridViewColumn Header="מייל" DisplayMemberBinding="{Binding mail}" Width="85"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Page>
