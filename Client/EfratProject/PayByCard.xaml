<Page x:Class="EfratProject.PayByCard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PayByCard">

        <StackPanel>
            <TextBlock Text="פרטי אשראי" Width="264" HorizontalAlignment="Center"  FontWeight="Bold" FontSize="36" />

            <TextBlock Text="" Height="20"/>



            <DockPanel FlowDirection="RightToLeft">
                <Label  Content="מספר כרטיס" Width="150" Margin="5" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" FontSize="18"/>
                <TextBox Text="{Binding CardNumber}" Width="295" HorizontalAlignment="Left" Margin="5"/>
            </DockPanel>

            <DockPanel FlowDirection="RightToLeft">
                <Label  Content="תוקף" Width="150" Margin="5" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" FontSize="18"/>
                <TextBox Text="{Binding Validity}" Width="295" HorizontalAlignment="Left" Margin="5"/>
            </DockPanel>

            <DockPanel FlowDirection="RightToLeft">
                <Label  Content="CVV" Width="150" Margin="5" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" FontSize="18"/>
                <TextBox Text="{Binding cvv}" Width="295" HorizontalAlignment="Left" Margin="5"/>
            </DockPanel>

            <DockPanel FlowDirection="RightToLeft">
                <Label Content="ת.ז בעל הכרטיס" Width="150" Margin="5" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" FontSize="18"/>
            <!--<TextBox Text="{Binding customerId}" Width="295" HorizontalAlignment="Left" Margin="5">--> 
            <TextBox  Width="295" HorizontalAlignment="Left" Margin="5">
                <Binding Path="customerId">
                    <Binding.ValidationRules>
                        <local:IsID/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox>
                
            </DockPanel>

        <DockPanel FlowDirection="RightToLeft">
            <Label Content="מס תשלומים" Width="150" Margin="5" VerticalContentAlignment="Bottom" HorizontalAlignment="Left" FontSize="18"/>
            <TextBox Text="{Binding NumOfPament}" Width="295" HorizontalAlignment="Left" Margin="5"/>
        </DockPanel>

        <Frame x:Name="f"/>
        <Button x:Name="ADD" Content="הבא" Width="80" Height="30" Margin="5" Click="ADD_Click"  FontFamily="Bahnschrift SemiLight"/>
        </StackPanel>
  
</Page>
