<Page x:Class="EfratProject.Finish"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Finish">

    <StackPanel>
        <TextBlock Text="הערות להזמנה" HorizontalAlignment="Center" />
        <TextBox Name="Notes" Width="150" Text="{Binding Path=notes}"/>
        <Button  Content="אישור ושליחת הזמנה" Click="finishhh" />
        <Image Source="/pictures/LOGOEK.png" Height="74" Width="116" />
    </StackPanel>
</Page>
