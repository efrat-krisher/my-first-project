<Page x:Class="EfratProject.KatalogProducts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KatalogProducts">

    <Grid>
        <Grid FlowDirection="RightToLeft" Background="#FFF1D6D3">

            <StackPanel>
                <TextBlock Name="kategoria" FontSize="75" HorizontalAlignment="Center"  />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <UniformGrid Name="txtKatalogPro" />
                </ScrollViewer>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
