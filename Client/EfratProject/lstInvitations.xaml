<Page x:Class="EfratProject.lstInvitations"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="lstInvitations" >

    <StackPanel FlowDirection="RightToLeft">
        <DockPanel>
            <TextBlock Text="רשימת הזמנות" FontSize="17" Background="Beige" />
            <Button Content="חזור לתפריט" Width="116" FontSize="20"  Click="Back" HorizontalAlignment="Right"/>
        </DockPanel>
    
        <StackPanel  Orientation="Horizontal">
            <!--שהלחצנים יהיו אחד ליד השני-->
            <Button Name="aCity" Click="City" FontSize="15" Content="הצגת הזמנות לפי ערים" />
            <Button Name="aAll" Click="All" FontSize="15" Content="הצגת כל הזמנות "/>
            <Button Name="aToday" Click="Today" FontSize="15" Content="הצגת ההזמנות להיום" />
            <!--<Button Name="aNotPacked" FontSize="15" Click="NotPacked" Content="הצגת ההזמנות שלא נארזו"/>
            <Button Name="aMonth" FontSize="15" Click="Month" Content="הצגת הזמנות מהחודש האחרון"/>-->
        </StackPanel>
        <!--<Button Content="בחר עיר" Click="It" />--><!--
        <ListView x:Name="LstCity" Width="auto" SelectionChanged="LstCity_SelectionChanged" >
            <ListView.View>
                <GridView >
                    <GridViewColumn Header="שם העיר" DisplayMemberBinding="{Binding CityName}"/>
                    --><!--<GridViewColumn Header="יום חלוקה" DisplayMemberBinding="{Binding DayInWeek}"/>--><!--
                </GridView>
            </ListView.View>
        </ListView>
        <Button Content="אריזת הזמנה" Click="Perut"/>
        <DockPanel>
            <TextBlock  FontSize="15" Text="הזמנות לאספקה ל" Background="White" Name="x" />
            <TextBlock   FontSize="15" Name="txtCity" FontWeight="Bold"  />
        </DockPanel>
        <ListView x:Name="lstInvitations1" Width="auto">
            <ListView.View>
                <GridView >
                    <GridViewColumn Header=" תאריך הזמנה" DisplayMemberBinding="{Binding Date}" Width="78"/>
                    --><!--<GridViewColumn Header="קוד לקוח" DisplayMemberBinding="{Binding Code}" Width="70"/>--><!--
                    <GridViewColumn Header="שם פרטי " DisplayMemberBinding="{Binding Customer.FirstName}" Width="65"/>
                    <GridViewColumn Header=" שם משפחה" DisplayMemberBinding="{Binding Customer.LastName}" Width="70"/>
                    <GridViewColumn Header="טלפון" DisplayMemberBinding="{Binding Customer.phone}" Width="75"/>
                    <GridViewColumn Header="עיר מגורים" DisplayMemberBinding="{Binding Customer.city1.CityName}" Width="70"/>
                    <GridViewColumn Header="רחוב" DisplayMemberBinding="{Binding Customer.adress}" Width="80"/>
                    <GridViewColumn Header="בית" DisplayMemberBinding="{Binding Customer.hous}" Width="40"/>
                    <GridViewColumn Header="קומה" DisplayMemberBinding="{Binding Customer.floor}" Width="40"/>
                    <GridViewColumn Header="דירה" DisplayMemberBinding="{Binding Customer.apartment}" Width="40"/>
                    <GridViewColumn Header="סטטוס" DisplayMemberBinding="{Binding sent}" Width="45"/>
                    --><!--נשלח או לא נשלח--><!--
                </GridView>
            </ListView.View>
        </ListView>-->
        <Frame  Grid.Row="1" x:Name="f2"/>
    </StackPanel>
</Page>
