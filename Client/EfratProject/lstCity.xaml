<Page x:Class="EfratProject.lstCity"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:EfratProject"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="lstCity">

    <StackPanel FlowDirection="RightToLeft">
        <StackPanel  Orientation="Horizontal" FlowDirection="LeftToRight">
            <Button Height="55" Background="Transparent" BorderThickness="0" Click="NewCity">
                <Image Source="/pictures/AddNewCity.png" />  <!--הוספת עיר חדשה-->
            </Button>
            <Button  x:Name="delete" Background="Transparent" BorderThickness="0"   Click="DeleteCity"  Height="55" >
                <Image Source="/pictures/CityDelete.png" /> <!--מחיקה-->
            </Button>
            <Button x:Name="update" Background="Transparent" BorderThickness="0" Click="updateCity" Height="55" >
                <Image Source="/pictures/CityRebuild.png" /> <!--עדכון-->
            </Button>
            <Button x:Name="Home" Background="Transparent" ToolTip="דף הבית" BorderThickness="0" Click="GoHome" Height="50">
                <Image Source="/pictures/home.svg.png" Height="55" /> <!--בית-->
            </Button>
        </StackPanel>
        <TextBlock Text="רשימת ערים" Background="Beige" FontSize="17"  />
 
        <ListView x:Name="LstCity" Width="auto" FontSize="15" >
            <ListView.View>
                <GridView >
                    <GridViewColumn Header="שם העיר" DisplayMemberBinding="{Binding CityName}" Width="100"/>
                    <!--<GridViewColumn Header="יום חלוקה" DisplayMemberBinding="{Binding DayInWeek}"/>-->
                    <GridViewColumn Header="יום חלוקה" Width="100">
                        <GridViewColumn.DisplayMemberBinding>
                            <Binding Path="DayInWeek">
                                <Binding.Converter>
                                    <local:ConvertDays/>
                                </Binding.Converter>
                            </Binding>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>       
    </StackPanel>
</Page>
